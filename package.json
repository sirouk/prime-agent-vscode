{
  "name": "prime-agent-vscode",
  "displayName": "Prime Agent",
  "description": "Chat with Prime Agent from VS Code. Streams from the Prime Agent RPC protocol with full tool-call visibility.",
  "version": "1.0.11",
  "publisher": "sirouk",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "prime agent",
    "prime intellect",
    "ai agent",
    "coding agent",
    "chat",
    "rlm",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sirouk/prime-agent-vscode"
  },
  "homepage": "https://github.com/sirouk/prime-agent-vscode",
  "bugs": "https://github.com/sirouk/prime-agent-vscode/issues",
  "galleryBanner": {
    "color": "#0f0f0f",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Launches a local agent process that reads and writes files in the workspace."
    },
    "virtualWorkspaces": false
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prime-agent",
          "title": "Prime Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "prime-agent": [
        {
          "id": "primeAgent.chat",
          "type": "webview",
          "name": "Chat",
          "icon": "media/icon.svg",
          "contextualTitle": "Prime Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "primeAgent.openChat",
        "title": "Open Chat in Editor Tab",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "primeAgent.focusChat",
        "title": "Focus Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "primeAgent.newSession",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "primeAgent.abort",
        "title": "Stop Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "primeAgent.compact",
        "title": "Compact Context",
        "icon": "$(fold)"
      },
      {
        "command": "primeAgent.exportChat",
        "title": "Export Chat…",
        "icon": "$(export)"
      },
      {
        "command": "primeAgent.history",
        "title": "Resume Recent Session…",
        "icon": "$(history)"
      },
      {
        "command": "primeAgent.restart",
        "title": "Restart Agent Process",
        "icon": "$(debug-restart)"
      },
      {
        "command": "primeAgent.addSelectionToChat",
        "title": "Add Selection to Chat",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "primeAgent.addActiveFileToChat",
        "title": "Add Active File to Chat",
        "icon": "$(file)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "primeAgent.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "9_primeagent@1"
        },
        {
          "command": "primeAgent.addActiveFileToChat",
          "when": "!editorHasSelection",
          "group": "9_primeagent@2"
        }
      ],
      "editor/title": [
        {
          "command": "primeAgent.focusChat",
          "when": "editorTextFocus",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "primeAgent.addSelectionToChat",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "primeAgent.focusChat",
        "key": "ctrl+alt+meta+p",
        "mac": "ctrl+alt+cmd+p"
      },
      {
        "command": "primeAgent.addSelectionToChat",
        "key": "alt+cmd+k",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Prime Agent",
      "properties": {
        "primeAgent.command": {
          "type": "string",
          "default": "prime-agent",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Command used to start the Prime Agent CLI. Set to an absolute path (e.g. /path/to/prime-agent.sh) when prime-agent is not on PATH."
        },
        "primeAgent.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "ignoreSync": true,
          "description": "Extra CLI arguments appended after `--mode rpc` (e.g. [\"--provider\", \"chutes\"])."
        },
        "primeAgent.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Model passed as --model when the agent starts (provider/id pattern). Empty uses the default model."
        },
        "primeAgent.maxFileSearchResults": {
          "type": "number",
          "default": 40,
          "description": "Maximum results returned for @ file mention search."
        },
        "primeAgent.sendSelectionSnippet": {
          "type": "boolean",
          "default": true,
          "description": "Include the selected code as context when using 'Add Selection to Chat'."
        },
        "primeAgent.defaultStreamingBehavior": {
          "type": "string",
          "enum": [
            "steer",
            "followUp"
          ],
          "default": "steer",
          "description": "How messages sent while the agent is working are delivered: steer interrupts after the current turn, followUp waits until the run ends. Toggleable per-run in the chat rail."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node esbuild.config.mjs --production && npx @vscode/vsce package --no-dependencies",
    "smoke": "node test/smoke.mjs",
    "test": "node test/activate.test.mjs && node test/chat-view-message.test.mjs && node test/session-controller-boundary.test.mjs && node test/attach-lifecycle.test.mjs && node test/session-actions.test.mjs && node test/webview.test.mjs && node test/transcript-window.test.mjs && node test/thread-diffs.test.mjs && node test/export-md.test.mjs && node test/recent-sessions-tail.test.mjs && node test/transport-regression.test.mjs",
    "test:live": "node esbuild.config.mjs && node test/daemon-parity.mjs --require-daemon && node test/host-e2e.mjs && node test/smoke.mjs",
    "pretest": "node esbuild.config.mjs",
    "presmoke": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  }
}
